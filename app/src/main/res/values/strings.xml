    <string name="settings_about_body">Muisc is a local music player with a DJ-style transition engine: one song glides into the next. Album playback stays gapless and untouched.</string>

    <!-- DJ customization (Settings → DJ, the Next transition sheet) -->
    <string name="settings_dj">DJ</string>
    <string name="dj_section_body">Styles, recipes and presets change how Muisc mixes; pins and ratings teach it about specific songs. Everything lives in the app\'s own storage, in the same layout as the command-line tool\'s profile folder.</string>
    <string name="dj_connecting">Connecting to the playback engine…</string>
    <string name="dj_problems_title">%1$d problem(s) reading your DJ files</string>
    <string name="dj_show_all">Show all</string>
    <string name="dj_yours">Yours</string>
    <string name="dj_style">Style</string>
    <string name="dj_style_body">A style reshapes your transition settings while it is chosen: energy, favoured and avoided techniques, presets. Your own settings are kept and come back when you choose None.</string>
    <string name="dj_style_none">None</string>
    <string name="dj_style_none_body">Only your own transition settings.</string>
    <string name="dj_show_settings">What it changes</string>
    <string name="dj_hide_settings">Hide details</string>
    <string name="dj_recipes">Recipes</string>
    <string name="dj_recipes_body">Recipes are transitions described in a small JSON file: per-deck level, EQ, filter, echo, reverb and stem lanes over bars. Import one with the folder button; a recipe that is in use competes with the built-in techniques.</string>
    <string name="dj_recipes_empty">No recipes found. Import a .json recipe with the folder button.</string>
